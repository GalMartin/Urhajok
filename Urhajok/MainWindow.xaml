<Window x:Class="Urhajok.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Urhajok"
        mc:Ignorable="d"
        Title="Urhajok" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Orientation="Vertical">
            <Button Content="Adatok betöltése"
                    Width="150"
                    Margin="10"
                    Padding="5"
                    Click="betoltes"/>
            <Button Content="Hány űrhajó van?"
                    Width="150"
                    Margin="10"
                    Padding="5"
                    Click="hanyurhajo"/>
            <Button Content="Melyinek a leghosszabb a hatótáva?"
                    Width="150"
                    Margin="10"
                    Padding="5"
                    Click="leghosszabb"/>
            <Button Content="Kik voltak a küldetésen?"
                    Width="150"
                    Margin="10"
                    Padding="5"
                    Click="kuldetes"/>
            <Button Content="Átlagos legénységszám"
                    Width="150"
                    Margin="10"
                    Padding="5"
                    Click="atlag"/>
            <Button Content="Gyártók szerinti csoportosítás"
                    Width="150"
                    Margin="10"
                    Padding="5"
                    Click="gyartokszerint"/>
        </StackPanel>

        <DataGrid x:Name="datagrid"
                  Grid.Column="1"
                  Margin="10"
                  IsReadOnly="True"
                  AutoGenerateColumns="True"/>

    </Grid>
</Window>
